{
	"expo": {
		"name": "Sort of Budget",
		"slug": "budget",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "light",
		"ios": {
			"supportsTablet": false,
			"bundleIdentifier": "io.egorov.budget",
			"appleTeamId": "MG48329H8U",
			"infoPlist": {
				"NSMicrophoneUsageDescription": "Sort of Budget listens when you tap the microphone, to turn what you say into an expense or a transfer. Audio stays on this iPhone.",
				"NSSpeechRecognitionUsageDescription": "Sort of Budget turns what you say into text on this iPhone. Your speech is not sent to a server."
			}
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/android-icon-foreground.png",
				"backgroundImage": "./assets/android-icon-background.png",
				"monochromeImage": "./assets/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"package": "io.egorov.budget"
		},
		"web": {
			"bundler": "metro",
			"output": "single",
			"favicon": "./assets/favicon.png"
		},
		"plugins": ["expo-router", "expo-sqlite", "expo-sharing"],
		"scheme": "budget",
		"experiments": {
			"typedRoutes": true
		}
	}
}
